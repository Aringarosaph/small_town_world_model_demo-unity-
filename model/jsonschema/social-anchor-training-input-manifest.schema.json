{
  "$defs": {
    "ArtifactDescriptor": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "relative_path": {
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "relative_path",
        "sha256",
        "bytes"
      ],
      "title": "ArtifactDescriptor",
      "type": "object"
    },
    "BehaviorId": {
      "enum": [
        "idle",
        "sleep",
        "eat_at_home",
        "shower",
        "watch_tv",
        "relax_at_home",
        "work_shift",
        "take_break",
        "buy_groceries",
        "eat_at_cafe",
        "drink_at_bar",
        "walk_in_park",
        "sit_in_park",
        "greet",
        "chat",
        "joke",
        "compliment",
        "share_event",
        "invite_join",
        "apologize",
        "confront",
        "end_conversation"
      ],
      "title": "BehaviorId",
      "type": "string"
    },
    "SocialAnchorReviewedBatchSource": {
      "additionalProperties": false,
      "properties": {
        "batch_manifest": {
          "$ref": "#/$defs/ArtifactDescriptor"
        },
        "behavior_id": {
          "$ref": "#/$defs/BehaviorId"
        },
        "draft_approval": {
          "$ref": "#/$defs/ArtifactDescriptor"
        }
      },
      "required": [
        "behavior_id",
        "batch_manifest",
        "draft_approval"
      ],
      "title": "SocialAnchorReviewedBatchSource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "coverage_policy": {
      "$ref": "#/$defs/ArtifactDescriptor"
    },
    "created_at_utc": {
      "minLength": 1,
      "title": "Created At Utc",
      "type": "string"
    },
    "excluded_anchor_holdout_count": {
      "const": 60,
      "default": 60,
      "title": "Excluded Anchor Holdout Count",
      "type": "integer"
    },
    "excluded_partition": {
      "const": "ANCHOR_HOLDOUT",
      "default": "ANCHOR_HOLDOUT",
      "title": "Excluded Partition",
      "type": "string"
    },
    "final_anchor_approval": {
      "$ref": "#/$defs/ArtifactDescriptor"
    },
    "fit_judgments": {
      "$ref": "#/$defs/ArtifactDescriptor"
    },
    "heuristic_passthrough_output_paths": {
      "items": {
        "enum": [
          "need_delta_preview.hunger",
          "need_delta_preview.energy",
          "need_delta_preview.hygiene",
          "need_delta_preview.fun",
          "need_delta_preview.social",
          "event_probabilities"
        ],
        "type": "string"
      },
      "minItems": 6,
      "title": "Heuristic Passthrough Output Paths",
      "type": "array"
    },
    "included_partitions": {
      "default": [
        "TRAIN",
        "VALIDATION"
      ],
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "const": "TRAIN",
          "type": "string"
        },
        {
          "const": "VALIDATION",
          "type": "string"
        }
      ],
      "title": "Included Partitions",
      "type": "array"
    },
    "project_name": {
      "const": "Small Town World Model（STWM）",
      "default": "Small Town World Model（STWM）",
      "title": "Project Name",
      "type": "string"
    },
    "raw_dataset_manifest": {
      "$ref": "#/$defs/ArtifactDescriptor"
    },
    "schema": {
      "const": "stwm.model.social-anchor-training-input-manifest/v1",
      "default": "stwm.model.social-anchor-training-input-manifest/v1",
      "title": "Schema",
      "type": "string"
    },
    "source_batches": {
      "items": {
        "$ref": "#/$defs/SocialAnchorReviewedBatchSource"
      },
      "maxItems": 7,
      "minItems": 7,
      "title": "Source Batches",
      "type": "array"
    },
    "source_commit": {
      "pattern": "^[a-f0-9]{40}$",
      "title": "Source Commit",
      "type": "string"
    },
    "source_dataset_manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Dataset Manifest Sha256",
      "type": "string"
    },
    "tasks": {
      "$ref": "#/$defs/ArtifactDescriptor"
    },
    "train_count": {
      "const": 210,
      "default": 210,
      "title": "Train Count",
      "type": "integer"
    },
    "training_eligible": {
      "const": true,
      "default": true,
      "title": "Training Eligible",
      "type": "boolean"
    },
    "validation_count": {
      "const": 30,
      "default": 30,
      "title": "Validation Count",
      "type": "integer"
    }
  },
  "required": [
    "source_commit",
    "created_at_utc",
    "source_dataset_manifest_sha256",
    "raw_dataset_manifest",
    "coverage_policy",
    "tasks",
    "final_anchor_approval",
    "fit_judgments",
    "source_batches",
    "heuristic_passthrough_output_paths"
  ],
  "title": "SocialAnchorTrainingInputManifest",
  "type": "object"
}
