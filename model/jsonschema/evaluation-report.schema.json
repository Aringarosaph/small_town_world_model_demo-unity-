{
  "$defs": {
    "EvaluationMetric": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "passed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Passed"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "EvaluationMetric",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "dataset_manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Dataset Manifest Sha256",
      "type": "string"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/EvaluationMetric"
      },
      "minItems": 1,
      "title": "Metrics",
      "type": "array"
    },
    "model_version": {
      "minLength": 1,
      "title": "Model Version",
      "type": "string"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "project_name": {
      "const": "Small Town World Model（STWM）",
      "default": "Small Town World Model（STWM）",
      "title": "Project Name",
      "type": "string"
    },
    "schema": {
      "const": "stwm.model.evaluation-report/v1",
      "default": "stwm.model.evaluation-report/v1",
      "title": "Schema",
      "type": "string"
    },
    "source_commit": {
      "pattern": "^[a-f0-9]{40}$",
      "title": "Source Commit",
      "type": "string"
    }
  },
  "required": [
    "model_version",
    "source_commit",
    "dataset_manifest_sha256",
    "metrics",
    "passed"
  ],
  "title": "EvaluationReport",
  "type": "object"
}
