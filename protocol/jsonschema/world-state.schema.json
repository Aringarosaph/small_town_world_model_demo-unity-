{
  "$defs": {
    "ActionPhase": {
      "enum": [
        "CREATED",
        "RESERVING",
        "TRAVELING",
        "ALIGNING",
        "PERFORMING",
        "RESOLVING",
        "COMPLETED",
        "CANCELLED",
        "FAILED",
        "INTERRUPTED"
      ],
      "title": "ActionPhase",
      "type": "string"
    },
    "ActionState": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "pattern": "^action_[0-9]+$",
          "title": "Action Id",
          "type": "string"
        },
        "agent_ids": {
          "items": {
            "pattern": "^npc_[0-9]{2}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Agent Ids",
          "type": "array"
        },
        "behavior_id": {
          "$ref": "#/$defs/BehaviorId"
        },
        "destination_location_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Destination Location Id"
        },
        "phase": {
          "$ref": "#/$defs/ActionPhase"
        },
        "planned_end_game_minute": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Planned End Game Minute"
        },
        "started_at_game_minute": {
          "minimum": 0,
          "title": "Started At Game Minute",
          "type": "integer"
        },
        "target_object_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*_[0-9]{2}$",
            "type": "string"
          },
          "title": "Target Object Ids",
          "type": "array"
        }
      },
      "required": [
        "action_id",
        "behavior_id",
        "agent_ids",
        "phase",
        "destination_location_id",
        "target_object_ids",
        "started_at_game_minute",
        "planned_end_game_minute"
      ],
      "title": "ActionState",
      "type": "object"
    },
    "AgentState": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "pattern": "^npc_[0-9]{2}$",
          "title": "Agent Id",
          "type": "string"
        },
        "assigned_work_location_id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Assigned Work Location Id",
          "type": "string"
        },
        "assigned_workstation_tag": {
          "$ref": "#/$defs/CapabilityTag"
        },
        "current_action_id": {
          "anyOf": [
            {
              "pattern": "^action_[0-9]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Current Action Id"
        },
        "current_location_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "const": "TRAVELING",
              "type": "string"
            }
          ],
          "title": "Current Location Id"
        },
        "decision_due_at": {
          "minimum": 0,
          "title": "Decision Due At",
          "type": "integer"
        },
        "display_name_key": {
          "title": "Display Name Key",
          "type": "string"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "home_location_id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Home Location Id",
          "type": "string"
        },
        "household_id": {
          "pattern": "^household_[a-z]$",
          "title": "Household Id",
          "type": "string"
        },
        "known_event_ids": {
          "items": {
            "pattern": "^event_[0-9]+$",
            "type": "string"
          },
          "title": "Known Event Ids",
          "type": "array"
        },
        "mood": {
          "$ref": "#/$defs/MoodValues"
        },
        "needs": {
          "$ref": "#/$defs/NeedValues"
        },
        "personality": {
          "$ref": "#/$defs/PersonalityValues"
        },
        "schedule_id": {
          "pattern": "^schedule_npc_[0-9]{2}$",
          "title": "Schedule Id",
          "type": "string"
        },
        "social_cooldowns": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Social Cooldowns",
          "type": "object"
        }
      },
      "required": [
        "agent_id",
        "household_id",
        "display_name_key",
        "home_location_id",
        "current_location_id",
        "assigned_work_location_id",
        "assigned_workstation_tag",
        "current_action_id",
        "needs",
        "personality",
        "mood",
        "schedule_id",
        "known_event_ids",
        "social_cooldowns",
        "decision_due_at",
        "enabled"
      ],
      "title": "AgentState",
      "type": "object"
    },
    "BehaviorId": {
      "enum": [
        "idle",
        "sleep",
        "eat_at_home",
        "shower",
        "watch_tv",
        "relax_at_home",
        "work_shift",
        "take_break",
        "buy_groceries",
        "eat_at_cafe",
        "drink_at_bar",
        "walk_in_park",
        "sit_in_park",
        "greet",
        "chat",
        "joke",
        "compliment",
        "share_event",
        "invite_join",
        "apologize",
        "confront",
        "end_conversation"
      ],
      "title": "BehaviorId",
      "type": "string"
    },
    "CapabilityTag": {
      "enum": [
        "SLEEP",
        "FOOD_SOURCE_HOME",
        "SIT",
        "EAT",
        "HYGIENE",
        "RELAX",
        "WATCH_TV",
        "ENTERTAINMENT",
        "WORK",
        "CAFE_MORNING",
        "CAFE_EVENING",
        "SHOP",
        "WORKSHOP",
        "GROCERY_SOURCE",
        "PURCHASE",
        "BUY_MEAL",
        "BUY_DRINK",
        "REST",
        "WALK_ROUTE",
        "SOCIAL_POSITION"
      ],
      "title": "CapabilityTag",
      "type": "string"
    },
    "HouseholdState": {
      "additionalProperties": false,
      "properties": {
        "food_units": {
          "minimum": 0,
          "title": "Food Units",
          "type": "integer"
        },
        "home_location_id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Home Location Id",
          "type": "string"
        },
        "household_id": {
          "pattern": "^household_[a-z]$",
          "title": "Household Id",
          "type": "string"
        },
        "member_ids": {
          "items": {
            "pattern": "^npc_[0-9]{2}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Member Ids",
          "type": "array"
        },
        "money": {
          "minimum": 0,
          "title": "Money",
          "type": "integer"
        }
      },
      "required": [
        "household_id",
        "member_ids",
        "home_location_id",
        "money",
        "food_units"
      ],
      "title": "HouseholdState",
      "type": "object"
    },
    "InteractionObjectState": {
      "additionalProperties": false,
      "properties": {
        "capability_tags": {
          "items": {
            "$ref": "#/$defs/CapabilityTag"
          },
          "minItems": 1,
          "title": "Capability Tags",
          "type": "array"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "location_id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Location Id",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Metadata",
          "type": "object"
        },
        "object_id": {
          "pattern": "^[a-z][a-z0-9_]*_[0-9]{2}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_type": {
          "$ref": "#/$defs/ObjectType"
        },
        "occupied_slots": {
          "additionalProperties": {
            "pattern": "^action_[0-9]+$",
            "type": "string"
          },
          "title": "Occupied Slots",
          "type": "object"
        },
        "slot_count": {
          "exclusiveMinimum": 0,
          "title": "Slot Count",
          "type": "integer"
        },
        "unity_binding_required": {
          "title": "Unity Binding Required",
          "type": "boolean"
        }
      },
      "required": [
        "object_id",
        "object_type",
        "location_id",
        "capability_tags",
        "slot_count",
        "occupied_slots",
        "enabled",
        "unity_binding_required",
        "metadata"
      ],
      "title": "InteractionObjectState",
      "type": "object"
    },
    "LocationState": {
      "additionalProperties": false,
      "properties": {
        "current_agent_ids": {
          "items": {
            "pattern": "^npc_[0-9]{2}$",
            "type": "string"
          },
          "title": "Current Agent Ids",
          "type": "array"
        },
        "location_id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Location Id",
          "type": "string"
        },
        "location_type": {
          "$ref": "#/$defs/LocationType"
        },
        "object_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*_[0-9]{2}$",
            "type": "string"
          },
          "title": "Object Ids",
          "type": "array"
        }
      },
      "required": [
        "location_id",
        "location_type",
        "current_agent_ids",
        "object_ids"
      ],
      "title": "LocationState",
      "type": "object"
    },
    "LocationType": {
      "enum": [
        "HOME",
        "CAFE_BAR",
        "SHOP",
        "WORKPLACE",
        "PARK"
      ],
      "title": "LocationType",
      "type": "string"
    },
    "MoodValues": {
      "additionalProperties": false,
      "properties": {
        "stress": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Stress",
          "type": "number"
        },
        "valence": {
          "maximum": 1.0,
          "minimum": -1.0,
          "title": "Valence",
          "type": "number"
        }
      },
      "required": [
        "valence",
        "stress"
      ],
      "title": "MoodValues",
      "type": "object"
    },
    "NeedValues": {
      "additionalProperties": false,
      "properties": {
        "energy": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Energy",
          "type": "number"
        },
        "fun": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Fun",
          "type": "number"
        },
        "hunger": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Hunger",
          "type": "number"
        },
        "hygiene": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Hygiene",
          "type": "number"
        },
        "social": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Social",
          "type": "number"
        }
      },
      "required": [
        "hunger",
        "energy",
        "hygiene",
        "fun",
        "social"
      ],
      "title": "NeedValues",
      "type": "object"
    },
    "ObjectType": {
      "enum": [
        "BED",
        "FRIDGE",
        "DINING_SEAT",
        "SHOWER",
        "SOFA",
        "TV",
        "WORKSTATION",
        "SHOP_SHELF",
        "CHECKOUT_COUNTER",
        "CAFE_COUNTER",
        "BAR_COUNTER",
        "PUBLIC_SEAT",
        "PARK_ROUTE",
        "LEISURE_SPOT",
        "CONVERSATION_ANCHOR"
      ],
      "title": "ObjectType",
      "type": "string"
    },
    "PersonalityValues": {
      "additionalProperties": false,
      "properties": {
        "discipline": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Discipline",
          "type": "number"
        },
        "frugality": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Frugality",
          "type": "number"
        },
        "irritability": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Irritability",
          "type": "number"
        },
        "sociability": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Sociability",
          "type": "number"
        }
      },
      "required": [
        "sociability",
        "discipline",
        "frugality",
        "irritability"
      ],
      "title": "PersonalityValues",
      "type": "object"
    },
    "RelationshipRole": {
      "enum": [
        "HOUSEHOLD_MEMBER",
        "COWORKER",
        "NEIGHBOR",
        "ACQUAINTANCE"
      ],
      "title": "RelationshipRole",
      "type": "string"
    },
    "RelationshipState": {
      "additionalProperties": false,
      "properties": {
        "affinity": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Affinity",
          "type": "number"
        },
        "familiarity": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Familiarity",
          "type": "number"
        },
        "last_interaction_minute": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Interaction Minute"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/RelationshipRole"
          },
          "title": "Roles",
          "type": "array"
        },
        "source_agent_id": {
          "pattern": "^npc_[0-9]{2}$",
          "title": "Source Agent Id",
          "type": "string"
        },
        "target_agent_id": {
          "pattern": "^npc_[0-9]{2}$",
          "title": "Target Agent Id",
          "type": "string"
        },
        "tension": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Tension",
          "type": "number"
        },
        "trust": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Trust",
          "type": "number"
        }
      },
      "required": [
        "source_agent_id",
        "target_agent_id",
        "roles",
        "familiarity",
        "affinity",
        "trust",
        "tension",
        "last_interaction_minute"
      ],
      "title": "RelationshipState",
      "type": "object"
    }
  },
  "$id": "urn:ai-town:protocol:0.1.0:world-state",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "active_actions": {
      "patternProperties": {
        "^action_[0-9]+$": {
          "$ref": "#/$defs/ActionState"
        }
      },
      "title": "Active Actions",
      "type": "object"
    },
    "agents": {
      "patternProperties": {
        "^npc_[0-9]{2}$": {
          "$ref": "#/$defs/AgentState"
        }
      },
      "title": "Agents",
      "type": "object"
    },
    "config_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Config Hash",
      "type": "string"
    },
    "dialogue_session_ids": {
      "items": {
        "pattern": "^conversation_[0-9]+$",
        "type": "string"
      },
      "title": "Dialogue Session Ids",
      "type": "array"
    },
    "event_cursor": {
      "minimum": 0,
      "title": "Event Cursor",
      "type": "integer"
    },
    "game_minute": {
      "minimum": 0,
      "title": "Game Minute",
      "type": "integer"
    },
    "households": {
      "patternProperties": {
        "^household_[a-z]$": {
          "$ref": "#/$defs/HouseholdState"
        }
      },
      "title": "Households",
      "type": "object"
    },
    "locations": {
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "$ref": "#/$defs/LocationState"
        }
      },
      "title": "Locations",
      "type": "object"
    },
    "model_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Model Version"
    },
    "objects": {
      "patternProperties": {
        "^[a-z][a-z0-9_]*_[0-9]{2}$": {
          "$ref": "#/$defs/InteractionObjectState"
        }
      },
      "title": "Objects",
      "type": "object"
    },
    "random_seed": {
      "minimum": 0,
      "title": "Random Seed",
      "type": "integer"
    },
    "relationships": {
      "items": {
        "$ref": "#/$defs/RelationshipState"
      },
      "title": "Relationships",
      "type": "array"
    },
    "schema_version": {
      "const": "v0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "state_version": {
      "minimum": 0,
      "title": "State Version",
      "type": "integer"
    },
    "world_id": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "World Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "world_id",
    "game_minute",
    "random_seed",
    "state_version",
    "agents",
    "households",
    "locations",
    "objects",
    "relationships",
    "active_actions",
    "dialogue_session_ids",
    "event_cursor",
    "model_version",
    "config_hash"
  ],
  "title": "WorldState",
  "type": "object"
}
