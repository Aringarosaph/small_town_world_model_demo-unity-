{
  "$defs": {
    "ObjectType": {
      "enum": [
        "BED",
        "FRIDGE",
        "DINING_SEAT",
        "SHOWER",
        "SOFA",
        "TV",
        "WORKSTATION",
        "SHOP_SHELF",
        "CHECKOUT_COUNTER",
        "CAFE_COUNTER",
        "BAR_COUNTER",
        "PUBLIC_SEAT",
        "PARK_ROUTE",
        "LEISURE_SPOT",
        "CONVERSATION_ANCHOR"
      ],
      "title": "ObjectType",
      "type": "string"
    },
    "PerceivedAgent": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "pattern": "^npc_[0-9]{2}$",
          "title": "Agent Id",
          "type": "string"
        },
        "location_id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Location Id",
          "type": "string"
        }
      },
      "required": [
        "agent_id",
        "location_id"
      ],
      "title": "PerceivedAgent",
      "type": "object"
    },
    "PerceivedObject": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "location_id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Location Id",
          "type": "string"
        },
        "object_id": {
          "pattern": "^[a-z][a-z0-9_]*_[0-9]{2}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_type": {
          "$ref": "#/$defs/ObjectType"
        }
      },
      "required": [
        "object_id",
        "object_type",
        "location_id",
        "enabled"
      ],
      "title": "PerceivedObject",
      "type": "object"
    }
  },
  "$id": "urn:ai-town:protocol:0.2.0:perception-snapshot",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authoritative_location_id": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Authoritative Location Id",
      "type": "string"
    },
    "authority": {
      "const": "HIGH_LEVEL_LOCATION",
      "title": "Authority",
      "type": "string"
    },
    "game_minute": {
      "minimum": 0,
      "title": "Game Minute",
      "type": "integer"
    },
    "observer_agent_id": {
      "pattern": "^npc_[0-9]{2}$",
      "title": "Observer Agent Id",
      "type": "string"
    },
    "perceived_agents": {
      "items": {
        "$ref": "#/$defs/PerceivedAgent"
      },
      "title": "Perceived Agents",
      "type": "array"
    },
    "perceived_objects": {
      "items": {
        "$ref": "#/$defs/PerceivedObject"
      },
      "title": "Perceived Objects",
      "type": "array"
    }
  },
  "required": [
    "observer_agent_id",
    "game_minute",
    "authority",
    "authoritative_location_id",
    "perceived_agents",
    "perceived_objects"
  ],
  "title": "PerceptionSnapshot",
  "type": "object"
}
