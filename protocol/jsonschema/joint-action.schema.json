{
  "$defs": {
    "BehaviorId": {
      "enum": [
        "idle",
        "sleep",
        "eat_at_home",
        "shower",
        "watch_tv",
        "relax_at_home",
        "work_shift",
        "take_break",
        "buy_groceries",
        "eat_at_cafe",
        "drink_at_bar",
        "walk_in_park",
        "sit_in_park",
        "greet",
        "chat",
        "joke",
        "compliment",
        "share_event",
        "invite_join",
        "apologize",
        "confront",
        "end_conversation"
      ],
      "title": "BehaviorId",
      "type": "string"
    },
    "JointActionParticipant": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "pattern": "^npc_[0-9]{2}$",
          "title": "Agent Id",
          "type": "string"
        },
        "proposal_id": {
          "pattern": "^proposal_[0-9]+$",
          "title": "Proposal Id",
          "type": "string"
        }
      },
      "required": [
        "agent_id",
        "proposal_id"
      ],
      "title": "JointActionParticipant",
      "type": "object"
    }
  },
  "$id": "urn:ai-town:protocol:0.1.0:joint-action",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_id": {
      "pattern": "^action_[0-9]+$",
      "title": "Action Id",
      "type": "string"
    },
    "authority": {
      "const": "CENTRAL_RESOLVER",
      "title": "Authority",
      "type": "string"
    },
    "behavior_id": {
      "$ref": "#/$defs/BehaviorId"
    },
    "location_id": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Location Id",
      "type": "string"
    },
    "participants": {
      "items": {
        "$ref": "#/$defs/JointActionParticipant"
      },
      "maxItems": 10,
      "minItems": 2,
      "title": "Participants",
      "type": "array"
    },
    "state_version": {
      "minimum": 0,
      "title": "State Version",
      "type": "integer"
    }
  },
  "required": [
    "action_id",
    "behavior_id",
    "authority",
    "state_version",
    "location_id",
    "participants"
  ],
  "title": "JointAction",
  "type": "object"
}
