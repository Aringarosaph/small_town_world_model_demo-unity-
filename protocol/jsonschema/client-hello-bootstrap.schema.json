{
  "$defs": {
    "ClientHelloPayload": {
      "additionalProperties": false,
      "properties": {
        "client_name": {
          "const": "unity",
          "title": "Client Name",
          "type": "string"
        },
        "supported_protocol_versions": {
          "items": {
            "$ref": "#/$defs/SupportedProtocolVersion"
          },
          "minItems": 1,
          "title": "Supported Protocol Versions",
          "type": "array"
        },
        "unity_editor_version": {
          "const": "6000.4.2f1",
          "title": "Unity Editor Version",
          "type": "string"
        }
      },
      "required": [
        "client_name",
        "unity_editor_version",
        "supported_protocol_versions"
      ],
      "title": "ClientHelloPayload",
      "type": "object"
    },
    "SupportedProtocolVersion": {
      "enum": [
        "0.1.0",
        "0.2.0"
      ],
      "type": "string"
    }
  },
  "$id": "urn:ai-town:protocol:0.2.0:client-hello-bootstrap",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "correlation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Correlation Id"
    },
    "message_id": {
      "pattern": "^msg_[0-9]+$",
      "title": "Message Id",
      "type": "string"
    },
    "message_type": {
      "const": "client_hello",
      "title": "Message Type",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/ClientHelloPayload"
    },
    "protocol_version": {
      "$ref": "#/$defs/SupportedProtocolVersion"
    },
    "sent_at_utc": {
      "format": "date-time",
      "title": "Sent At Utc",
      "type": "string"
    },
    "state_version": {
      "minimum": 0,
      "title": "State Version",
      "type": "integer"
    },
    "world_id": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "World Id",
      "type": "string"
    }
  },
  "required": [
    "protocol_version",
    "message_id",
    "message_type",
    "sent_at_utc",
    "world_id",
    "state_version",
    "correlation_id",
    "payload"
  ],
  "title": "ClientHelloMessage",
  "type": "object"
}
