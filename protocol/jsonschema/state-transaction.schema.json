{
  "$defs": {
    "EventType": {
      "enum": [
        "MEAL_CONSUMED",
        "GROCERIES_PURCHASED",
        "HOUSEHOLD_FOOD_LOW",
        "HOUSEHOLD_MONEY_LOW",
        "NEED_CRISIS",
        "WORK_STARTED",
        "WORK_COMPLETED",
        "WORK_LATE",
        "WORK_MISSED",
        "COWORKER_EXTRA_LOAD",
        "FIRST_GREETING",
        "POSITIVE_INTERACTION",
        "AWKWARD_INTERACTION",
        "INVITATION_ACCEPTED",
        "INVITATION_REJECTED",
        "APOLOGY_ACCEPTED",
        "APOLOGY_REJECTED",
        "CONFLICT_STARTED",
        "CONFLICT_ESCALATED",
        "CONFLICT_REDUCED",
        "EVENT_SHARED",
        "CONVERSATION_STARTED",
        "CONVERSATION_ENDED"
      ],
      "title": "EventType",
      "type": "string"
    },
    "EventWitnessScope": {
      "enum": [
        "PARTICIPANTS_ONLY",
        "HIGH_LEVEL_LOCATION"
      ],
      "title": "EventWitnessScope",
      "type": "string"
    },
    "HardEffect": {
      "additionalProperties": false,
      "properties": {
        "delta_integer": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delta Integer"
        },
        "field_path": {
          "minLength": 1,
          "title": "Field Path",
          "type": "string"
        },
        "set_string": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Set String"
        }
      },
      "required": [
        "field_path"
      ],
      "title": "HardEffect",
      "type": "object"
    },
    "MoodDelta": {
      "additionalProperties": false,
      "properties": {
        "stress": {
          "maximum": 1.0,
          "minimum": -1.0,
          "title": "Stress",
          "type": "number"
        },
        "valence": {
          "maximum": 1.0,
          "minimum": -1.0,
          "title": "Valence",
          "type": "number"
        }
      },
      "required": [
        "valence",
        "stress"
      ],
      "title": "MoodDelta",
      "type": "object"
    },
    "ProposalResult": {
      "enum": [
        "ACCEPTED",
        "OBJECT_SLOT_CONFLICT",
        "TARGET_UNAVAILABLE",
        "STATE_STALE",
        "INSUFFICIENT_FUNDS",
        "LOCATION_CLOSED",
        "SOCIAL_TARGET_COMMITTED"
      ],
      "title": "ProposalResult",
      "type": "string"
    },
    "RelationshipDelta": {
      "additionalProperties": false,
      "properties": {
        "affinity": {
          "maximum": 1.0,
          "minimum": -1.0,
          "title": "Affinity",
          "type": "number"
        },
        "familiarity": {
          "maximum": 1.0,
          "minimum": -1.0,
          "title": "Familiarity",
          "type": "number"
        },
        "tension": {
          "maximum": 1.0,
          "minimum": -1.0,
          "title": "Tension",
          "type": "number"
        },
        "trust": {
          "maximum": 1.0,
          "minimum": -1.0,
          "title": "Trust",
          "type": "number"
        }
      },
      "required": [
        "familiarity",
        "affinity",
        "trust",
        "tension"
      ],
      "title": "RelationshipDelta",
      "type": "object"
    },
    "ResolvedAction": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "pattern": "^action_[0-9]+$",
          "title": "Action Id",
          "type": "string"
        },
        "emitted_events": {
          "items": {
            "$ref": "#/$defs/WorldEvent"
          },
          "title": "Emitted Events",
          "type": "array"
        },
        "hard_effects": {
          "items": {
            "$ref": "#/$defs/HardEffect"
          },
          "title": "Hard Effects",
          "type": "array"
        },
        "result": {
          "$ref": "#/$defs/ProposalResult"
        },
        "soft_effects": {
          "items": {
            "$ref": "#/$defs/SoftEffect"
          },
          "title": "Soft Effects",
          "type": "array"
        },
        "source_proposal_ids": {
          "items": {
            "pattern": "^proposal_[0-9]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Proposal Ids",
          "type": "array"
        }
      },
      "required": [
        "action_id",
        "source_proposal_ids",
        "result",
        "hard_effects",
        "soft_effects",
        "emitted_events"
      ],
      "title": "ResolvedAction",
      "type": "object"
    },
    "SoftEffect": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "pattern": "^npc_[0-9]{2}$",
          "title": "Actor Id",
          "type": "string"
        },
        "actor_mood_delta": {
          "$ref": "#/$defs/MoodDelta"
        },
        "relationship_delta_target_to_actor": {
          "anyOf": [
            {
              "$ref": "#/$defs/RelationshipDelta"
            },
            {
              "type": "null"
            }
          ]
        },
        "relationship_direction": {
          "const": "TARGET_TO_ACTOR",
          "title": "Relationship Direction",
          "type": "string"
        },
        "target_id": {
          "anyOf": [
            {
              "pattern": "^npc_[0-9]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target Id"
        },
        "target_mood_delta": {
          "anyOf": [
            {
              "$ref": "#/$defs/MoodDelta"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "actor_id",
        "target_id",
        "actor_mood_delta",
        "target_mood_delta",
        "relationship_direction",
        "relationship_delta_target_to_actor"
      ],
      "title": "SoftEffect",
      "type": "object"
    },
    "WorldEvent": {
      "additionalProperties": false,
      "properties": {
        "actor_ids": {
          "items": {
            "pattern": "^npc_[0-9]{2}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Actor Ids",
          "type": "array"
        },
        "affected_agent_ids": {
          "items": {
            "pattern": "^npc_[0-9]{2}$",
            "type": "string"
          },
          "title": "Affected Agent Ids",
          "type": "array"
        },
        "event_id": {
          "pattern": "^event_[0-9]+$",
          "title": "Event Id",
          "type": "string"
        },
        "event_type": {
          "$ref": "#/$defs/EventType"
        },
        "game_minute": {
          "minimum": 0,
          "title": "Game Minute",
          "type": "integer"
        },
        "importance": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Importance",
          "type": "number"
        },
        "location_id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Location Id",
          "type": "string"
        },
        "payload": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Payload",
          "type": "object"
        },
        "source_action_id": {
          "anyOf": [
            {
              "pattern": "^action_[0-9]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Action Id"
        },
        "supersedes_event_id": {
          "anyOf": [
            {
              "pattern": "^event_[0-9]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes Event Id"
        },
        "witness_agent_ids": {
          "items": {
            "pattern": "^npc_[0-9]{2}$",
            "type": "string"
          },
          "title": "Witness Agent Ids",
          "type": "array"
        },
        "witness_scope": {
          "$ref": "#/$defs/EventWitnessScope"
        }
      },
      "required": [
        "event_id",
        "event_type",
        "game_minute",
        "location_id",
        "actor_ids",
        "affected_agent_ids",
        "witness_agent_ids",
        "source_action_id",
        "importance",
        "witness_scope",
        "payload"
      ],
      "title": "WorldEvent",
      "type": "object"
    }
  },
  "$id": "urn:ai-town:protocol:0.2.0:state-transaction",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "committed_event_ids": {
      "items": {
        "pattern": "^event_[0-9]+$",
        "type": "string"
      },
      "title": "Committed Event Ids",
      "type": "array"
    },
    "expected_state_version": {
      "minimum": 0,
      "title": "Expected State Version",
      "type": "integer"
    },
    "resolved_actions": {
      "items": {
        "$ref": "#/$defs/ResolvedAction"
      },
      "minItems": 1,
      "title": "Resolved Actions",
      "type": "array"
    }
  },
  "required": [
    "expected_state_version",
    "resolved_actions",
    "committed_event_ids"
  ],
  "title": "StateTransaction",
  "type": "object"
}
